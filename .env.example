# Resend email service for the Join page application form.
# Sign up at https://resend.com, verify your sending domain, create an API key.
# Copy this file to `.env.local`.

# Server-side API key (never exposed to the browser).
RESEND_API_KEY=

# Verified sender on your Resend domain. Example: "Founders HQ <apply@foundershq.org>"
JOIN_FROM_EMAIL=

# Inbox that receives applications. Example: team@foundershq.org
JOIN_TO_EMAIL=

# Canonical production URL — used for metadata, sitemap.xml and robots.txt.
# No trailing slash. Example: https://foundershq.org
NEXT_PUBLIC_SITE_URL=
