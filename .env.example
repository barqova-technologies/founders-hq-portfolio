# Form submission endpoint for the Join page application form.
# Sign up for a no-backend form service (e.g. Formspree, Web3Forms, Getform)
# and paste the form's POST URL here. Copy this file to `.env.local`.
#
# Example (Formspree): https://formspree.io/f/abcdwxyz
NEXT_PUBLIC_FORM_ENDPOINT=

# Canonical production URL — used for metadata, sitemap.xml and robots.txt.
# No trailing slash. Example: https://foundershq.org
NEXT_PUBLIC_SITE_URL=
